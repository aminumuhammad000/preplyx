# ==============================================================================
# PREPLYX BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5004
NODE_ENV=production
APP_TIMEZONE=Africa/Lagos

# Security & Authentication
# Generate a strong 64-byte random secret for JWT signing in production
JWT_SECRET=your_production_jwt_secret_key_change_me_immediately

# Cross-Origin Resource Sharing (CORS)
# URL of the student-facing frontend application
CLIENT_URL=https://app.preplyx.com.ng

# Database Configuration (MongoDB Atlas or Local replica set)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://preplyx_app:your_password@cluster0.mongodb.net/cbt_production?retryWrites=true&w=majority

# Redis Cache & BullMQ Queue Configuration (Optional - in-memory fallback enabled)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
EMAIL_FROM="Preplyx Learning <support@preplyx.com.ng>"

# AI & LLM Provider API Keys (Agent Router / Mistake Intelligence)
GEMINI_API_KEY=your_google_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Payment Gateway (VTStack / PalmPay)
VTSTACK_PUBLIC_KEY=vt_pub_live_xxx
VTSTACK_SECRET_KEY=vt_sec_live_xxx
VTSTACK_WEBHOOK_SECRET=vt_whsec_live_xxx
