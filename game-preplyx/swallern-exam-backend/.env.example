# New Swallern Exam Supabase project only. Never use the old topic/lesson project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-EXAM-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_EXAM_PROJECT_PUBLISHABLE_KEY

# Server-only; optional until private write/admin endpoints are introduced.
# Never add this value to Godot or NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=YOUR_NEW_EXAM_PROJECT_SERVER_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_NEW_EXAM_PROJECT_SERVICE_ROLE_KEY

# Optional browser origin for API CORS if the game is hosted on a separate origin.
GAME_ALLOWED_ORIGIN=*
